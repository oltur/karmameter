# MongoDB Atlas connection string (required)
CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/places

# Server-side Google Maps Platform API key - used for Places Nearby/Details,
# Place Photo proxy, and Elevation. Must NOT be the same browser-restricted
# key used client-side; this one is called server-to-server.
GOOGLE_MAPS_API_KEY=

# Optional, defaults to 3000
PORT=3000
